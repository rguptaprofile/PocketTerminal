{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo Static project - no install step needed",
  "buildCommand": "echo Static project - no build step needed",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/desktop", "destination": "/desktop.html" },
    { "source": "/mobile", "destination": "/mobile.html" }
  ]
}